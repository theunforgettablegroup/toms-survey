# Copy this file to `.env.local` and replace placeholder values.
# Do not commit `.env.local`.

# Supabase project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon/publishable key (safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Compatibility alias used by `supabase/server.ts` in this repo.
# Keep this the same value as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-public-anon-key

# Used by local scripts (e.g. scripts/seedQuestions.ts)
# Keep these the same as the NEXT_PUBLIC values above for local development.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Required for seeding admin-only tables (questions, answers) when RLS is enabled.
# Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
